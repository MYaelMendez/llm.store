{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "artifactType",
    "purpose",
    "image",
    "governance",
    "authority",
    "provisioning",
    "agents",
    "modules",
    "charter",
    "verification",
    "publication",
    "resourceLimits"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ae.store.computer.proposal.v0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$",
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 30
    },
    "status": {
      "type": "string",
      "const": "PROPOSED"
    },
    "artifactType": {
      "type": "string",
      "const": "virtual-computer-template"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "image": {
      "type": "null"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "computers/default/governance/dao.template.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "PROPOSED"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "inherit",
        "grants",
        "provisionerRetainsRuntimeAuthority"
      ],
      "properties": {
        "root": {
          "type": "string",
          "const": "human://root"
        },
        "inherit": {
          "type": "boolean",
          "const": false
        },
        "grants": {
          "type": "array",
          "maxItems": 0
        },
        "provisionerRetainsRuntimeAuthority": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "adapter"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "NOT_IMPLEMENTED"
        },
        "adapter": {
          "type": "null"
        }
      }
    },
    "agents": {
      "type": "array",
      "maxItems": 0
    },
    "modules": {
      "type": "array",
      "maxItems": 0
    },
    "charter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "CHARTER.md"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "NOT_EXECUTED"
        },
        "evidence": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "publisherIdentity",
        "artifactDigest"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "DRAFT"
        },
        "publisherIdentity": {
          "type": "null"
        },
        "artifactDigest": {
          "type": "null"
        }
      }
    },
    "resourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuMillis",
        "memoryBytes",
        "storageBytes",
        "networkRequests"
      ],
      "properties": {
        "cpuMillis": {
          "type": "integer",
          "const": 0
        },
        "memoryBytes": {
          "type": "integer",
          "const": 0
        },
        "storageBytes": {
          "type": "integer",
          "const": 0
        },
        "networkRequests": {
          "type": "integer",
          "const": 0
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inactive human-root computer proposal"
}
