{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm.store/spec/codae/plan-0.1.schema.json",
  "title": "codæ Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "planId",
    "principal",
    "intent",
    "capabilities",
    "steps",
    "status"
  ],
  "properties": {
    "protocol": {
      "const": "codae/0.1"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "input"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "const": "proposal"
    },
    "requiredScopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adapter": {
      "type": "string"
    }
  }
}
